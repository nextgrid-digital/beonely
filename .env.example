# Beonely — copy to `.env` and fill values

# Supabase (required for auth + data). There is no built-in project fallback.
# Use a staging project for Vercel Preview; leaving both blank keeps the app fail-closed.
# Project URL: https://<project-ref>.supabase.co (same project where you ran migrations, including Storage bucket `avatars`)
VITE_SUPABASE_URL=
# JWT anon key from Dashboard → API (client-safe). Not the service role key.
VITE_SUPABASE_ANON_KEY=

# Optional: same URL for server-only scripts / clarity (api/ falls back to VITE_SUPABASE_URL)
# SUPABASE_URL=

# Site URL (canonical, OG). Production: https://beonely.in (apex only; www redirects there).
# For Preview link/email testing, use that deployment's stable preview alias.
VITE_PUBLIC_SITE_URL=http://localhost:5173
# Optional Google Search Console verification token (the meta tag content value only)
VITE_GOOGLE_SITE_VERIFICATION=

# Turnstile payment abuse protection. Configure both values together in production.
# The site key is public; the secret is server-only.
VITE_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Razorpay (Standard Checkout)
# — Publishable key ID only (safe in the browser bundle). Optional: if unset,
#   create-order returns keyId from the server env for the checkout modal.
VITE_RAZORPAY_KEY_ID=
#
# — Server-only (Vercel `api/*` / `vercel dev`). Never use a VITE_ prefix for the secret.
#   Required for POST /api/create-order and /api/verify-payment.
#   Plan totals include 18% GST; amounts are defined in src/lib/payments/plans.ts.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=   # required in production; configure capture/order, failure, refund, and dispute lifecycle events

# Serverless + local `vercel dev` for /api routes (never VITE_* — never expose to browser)
# Required on Vercel for /api/create-order and /api/verify-payment (see docs/vercel-environment.md).
# SUPABASE_SERVICE_ROLE_KEY=
# Optional alias for API route JWT validation (defaults to VITE_SUPABASE_ANON_KEY)
# SUPABASE_ANON_KEY=

# Staff admin console (comma-separated emails; VITE_ prefix required for client route guards)
VITE_ADMIN_EMAIL_ALLOWLIST=you@company.com,ops@company.com
ADMIN_EMAIL_ALLOWLIST=you@company.com,ops@company.com

# Resend (transactional + marketing)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Beonely <team@beonely.in>   # transactional: receipts, moderation, applications, admin test send
# RESEND_FROM_TALENT=Beonely <talent@yourdomain.com>   # optional: candidate marketing
# RESEND_FROM_HIRING=Beonely <hiring@yourdomain.com>   # optional: recruiter marketing
# RESEND_WEBHOOK_SECRET=   # required when /api/resend-webhook is enabled (Resend signing secret)
# HIRING_REQUEST_NOTIFICATION_EMAILS=ops@example.com,talent@example.com
# CRON_SECRET=             # required for Vercel Cron; random value of at least 16 characters

# Optional daily LinkedIn-sync safeguards. Missing-from-payload expiry is off by default;
# enabling it still requires a healthy, complete scrape. Age/liveness expiry remains enabled.
# JOBS_SYNC_ENABLE_MISSING_EXPIRY=0
# JOBS_SYNC_MAX_AGE_DAYS=30
# JOBS_SYNC_CHECK_APPLY_URLS=1
