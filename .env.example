# Beonely — copy to `.env` and fill values

# Supabase (required for auth + data)
# Project URL: https://<project-ref>.supabase.co (same project where you ran migrations, including Storage bucket `avatars`)
VITE_SUPABASE_URL=
# JWT anon key from Dashboard → API (client-safe). Not the service role key.
VITE_SUPABASE_ANON_KEY=

# Optional: same URL for server-only scripts / clarity (api/ falls back to VITE_SUPABASE_URL)
# SUPABASE_URL=

# Site URL (canonical, OG)
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Turnstile (optional; widget keys are public)
VITE_TURNSTILE_SITE_KEY=

# Razorpay (Standard Checkout)
# — Publishable key ID only (safe to expose in the browser bundle). Optional: if unset, the
#   create-order API returns the server `RAZORPAY_KEY_ID` in JSON for the checkout modal.
VITE_RAZORPAY_KEY_ID=

# — Server-only (Vercel `api/*` / `vercel dev`). Never use a VITE_ prefix for the secret.
#   Required for POST /api/create-order and /api/verify-payment.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Serverless + local `vercel dev` for /api routes (never VITE_* — never expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=
# Optional alias for API route JWT validation (defaults to VITE_SUPABASE_ANON_KEY)
# SUPABASE_ANON_KEY=

# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Beonely <jobs@yourdomain.com>
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# CRON_INGEST_SECRET=
