{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/create-order.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/verify-payment.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/sitemap.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/razorpay-webhook.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
