{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/create-order.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/verify-payment.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/sitemap.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/razorpay-webhook.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/admin/notify-job-status.ts": { "maxDuration": 60 },
    "api/admin/campaigns.ts": { "maxDuration": 60 },
    "api/admin/campaign-send.ts": { "maxDuration": 60 },
    "api/admin/campaign-stats.ts": { "maxDuration": 60 },
    "api/admin/email-previews.ts": { "maxDuration": 30 },
    "api/admin/email/automations.ts": { "maxDuration": 30 },
    "api/admin/email/test-send.ts": { "maxDuration": 60 },
    "api/admin/email/analytics.ts": { "maxDuration": 30 },
    "api/admin/email/campaign-recipients.ts": { "maxDuration": 30 },
    "api/email/dispatch.ts": { "maxDuration": 60 },
    "api/notify-application.ts": { "maxDuration": 60 },
    "api/subscribe.ts": { "maxDuration": 30 },
    "api/unsubscribe.ts": { "maxDuration": 30 },
    "api/marketing-consent.ts": { "maxDuration": 30 },
    "api/resend-webhook.ts": { "maxDuration": 30 },
    "api/cron/weekly-digest.ts": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
