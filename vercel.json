{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/create-order.ts": {
      "maxDuration": 60
    },
    "api/verify-payment.ts": {
      "maxDuration": 60
    },
    "api/sitemap.ts": {
      "maxDuration": 60
    },
    "api/job-preview.ts": {
      "maxDuration": 30
    },
    "api/og-job.tsx": {
      "maxDuration": 60
    },
    "api/og-portfolio.tsx": {
      "maxDuration": 60
    },
    "api/portfolio-preview.ts": {
      "maxDuration": 30
    },
    "api/razorpay-webhook.ts": {
      "maxDuration": 60
    },
    "api/notify-application.ts": { "maxDuration": 60 },
    "api/marketing.ts": { "maxDuration": 30 },
    "api/resend-webhook.ts": { "maxDuration": 30 },
    "api/email/dispatch.ts": { "maxDuration": 60 },
    "api/cron.ts": { "maxDuration": 60 },
    "api/admin/[...segments].ts": { "maxDuration": 60 }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.beonely.in" }],
      "destination": "https://beonely.in/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/listing-expiry-reminders",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/subscribe",
      "destination": "/api/marketing?route=subscribe"
    },
    {
      "source": "/api/unsubscribe",
      "destination": "/api/marketing?route=unsubscribe"
    },
    {
      "source": "/api/marketing-consent",
      "destination": "/api/marketing?route=marketing-consent"
    },
    {
      "source": "/api/hiring-request",
      "destination": "/api/marketing?route=hiring-request"
    },
    {
      "source": "/api/og/job",
      "destination": "/api/og-job"
    },
    {
      "source": "/api/share/job",
      "destination": "/api/job-preview?mode=share"
    },
    {
      "source": "/api/og/portfolio",
      "destination": "/api/og-portfolio"
    },
    {
      "source": "/api/share/portfolio",
      "destination": "/api/portfolio-preview?mode=share"
    },
    {
      "source": "/api/cron/weekly-digest",
      "destination": "/api/cron?route=weekly-digest"
    },
    {
      "source": "/api/cron/listing-expiry-reminders",
      "destination": "/api/cron?route=listing-expiry-reminders"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
