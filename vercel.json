{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/create-order.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/verify-payment.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/sitemap.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/razorpay-webhook.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/notify-application.ts": { "maxDuration": 60 },
    "api/marketing.ts": { "maxDuration": 30 },
    "api/resend-webhook.ts": { "maxDuration": 30 },
    "api/email/dispatch.ts": { "maxDuration": 60 },
    "api/cron/weekly-digest.ts": { "maxDuration": 60 },
    "api/admin/[[...segments]].ts": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/api/subscribe",
      "destination": "/api/marketing?route=subscribe"
    },
    {
      "source": "/api/unsubscribe",
      "destination": "/api/marketing?route=unsubscribe"
    },
    {
      "source": "/api/marketing-consent",
      "destination": "/api/marketing?route=marketing-consent"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
